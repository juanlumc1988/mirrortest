# ---- Debug / profiling ----
*.dSYM/
*.su
*.idb
*.pdb
*.gcno
*.gcda
*.gcov
coverage/
*.profraw
*.profdata
callgrind.out.*
perf.data
perf.data.old
vgcore.*
# Deliberately no bare `core` rule: it would silently swallow any directory
# named core/ -- and include/mirrortest/core/ and src/core/ exist. core.1234
# and vgcore.* still match; an unsuffixed ./core dump is the price.
core.[0-9]*

# ---- Sanitizer / analysis output ----
*.asan
*.tsan
*.ubsan
cppcheck-report.*
scan-build-*/

# ---- mirrortest: generator side outputs ----
# The tool writes <file>.new next to a file it refuses to overwrite. In this
# repository those only ever appear by accident (running the tool on its own
# examples); the golden and round-trip tests write into the build tree.
# Golden cases that pin the refuse-to-overwrite behaviour DO track them.
*.new
!tests/golden/**/*.new

