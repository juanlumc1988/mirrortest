# SPDX-License-Identifier: Apache-2.0
# Part of mirrortest -- bidirectional C++ test/code generator.
#
# Compiles templates/**/*.inja into the binary, so the tool has no run-time
# dependency on an installation directory (docs/design.md, R17).
#
#   mt_embed_templates(<output.cpp> <templates-root>)
#
# writes <output.cpp> defining mt::core::embedded_templates() (declared in
# mirrortest/core/templates.h), one entry per template, named by its path
# relative to the root with '/' separators ("impl/header.inja"), in sorted
# order. The file is produced at configure time. Every template is registered
# as a configure dependency and the glob is re-checked on each build
# (CONFIGURE_DEPENDS), so editing, adding or removing a template reconfigures
# and rebuilds without anyone having to remember to.
#
# The output is only rewritten when its content changes, so a reconfigure that
# changed nothing does not recompile the library.
#
# Templates are normalised to LF here, as they are when loaded from a
# --templates directory: a Windows checkout with core.autocrlf must not make
# the generated code depend on how the repository was cloned.
#
# Limits: a template may not contain the raw-string terminator )mt_tpl"
# (the configure fails, naming the file). MSVC caps a string literal at ~16 KB,
# which is why the supported toolchains are GCC and Clang.

function(mt_embed_templates output root)
    file(GLOB_RECURSE templates RELATIVE "${root}" CONFIGURE_DEPENDS "${root}/*.inja")
    list(SORT templates)

    set(entries "")
    foreach(rel IN LISTS templates)
        file(READ "${root}/${rel}" content)
        string(REPLACE "\r\n" "\n" content "${content}")

        string(FIND "${content}" ")mt_tpl\"" clash)
        if(NOT clash EQUAL -1)
            message(FATAL_ERROR
                "mirrortest: ${root}/${rel} contains the raw-string terminator )mt_tpl\" "
                "and cannot be embedded. Reword that line.")
        endif()

        string(APPEND entries "    {\"${rel}\", R\"mt_tpl(${content})mt_tpl\"},\n")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${root}/${rel}")
    endforeach()

    set(source "// Generated by cmake/MtEmbedFiles.cmake from templates/. Do not edit.\n")
    string(APPEND source "#include \"mirrortest/core/templates.h\"\n\n")
    string(APPEND source "namespace mt::core {\n\n")
    string(APPEND source "std::vector<EmbeddedTemplate> embedded_templates() {\n")
    string(APPEND source "    return {\n${entries}    };\n}\n\n")
    string(APPEND source "}  // namespace mt::core\n")

    file(WRITE "${output}.tmp" "${source}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${output}.tmp" "${output}")
    file(REMOVE "${output}.tmp")
endfunction()
