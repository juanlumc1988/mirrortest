{% include "common/file_header.inja" %}

{% for line in includes %}
{{ line }}
{% endfor %}
{% for section in sections %}

{% if length(section.open) > 0 %}
{% for line in section.open %}
{{ line }}
{% endfor %}

{% endif %}
{% for fixture in section.fixtures %}
{% for line in fixture.lines %}
{{ line }}
{% endfor %}

{% endfor %}
{% for test in section.tests %}
{% for line in test.lines %}
{{ line }}
{% endfor %}
{% if not loop.is_last %}

{% endif %}
{% endfor %}
{% if length(section.close) > 0 %}

{% for line in section.close %}
{{ line }}
{% endfor %}
{% endif %}
{% endfor %}
